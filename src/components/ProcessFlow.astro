---
// The existing labeling request process — Waymo case study, "Key insights".
//
// WHY IT IS BUILT THIS WAY
// The source diagram was a 12-node horizontal chart, unreadable at the 660px
// reading measure. It is redrawn vertically into a fixed 660x952 coordinate
// space: one SVG carries every connector, nodes are absolutely positioned on
// top. Connectors are real polylines sharing one arrowhead marker, so elbows,
// merges and the loop-back all draw correctly — stacked flex boxes cannot
// express any of those.
//
// RULES — hold to them if you edit
//   - connectors live in the SVG only; never fake one with a bordered div
//   - every arrowhead is the shared <marker id="flowarrow">
//   - nodes sit on an opaque fill so connectors do not show through them
//   - a node's kind (terminal / decision / action / doc) is carried by border
//     and fill only, never by size — size means nothing here
//   - the "AT ANY POINT" note is part of the argument, not decoration: the real
//     escape hatch was asking a labeling engineer, which is the thing the
//     redesign set out to make unnecessary
//
// Geometry is raw numbers on purpose — it is a drawing, not spacing. Every
// colour and typeface below still comes from a token.
import { inline } from '../lib/text';

interface Props {
  caption?: string;
}

const { caption } = Astro.props;

const W = 660;
const H = 952;

type Kind = 'terminal' | 'decision' | 'action' | 'doc';

// x/y are the top-left of the box in the coordinate space above.
const nodes: { label: string; kind: Kind; x: number; y: number; w: number; h: number }[] = [
  { label: 'I need labels!', kind: 'terminal', x: 235, y: 8, w: 190, h: 44 },
  { label: 'First time?', kind: 'decision', x: 235, y: 92, w: 190, h: 44 },
  { label: 'Read the labeling process docs', kind: 'doc', x: 50, y: 190, w: 200, h: 52 },
  { label: 'Basic request?', kind: 'decision', x: 235, y: 290, w: 190, h: 44 },
  { label: 'Use the Easy Labeling form', kind: 'action', x: 40, y: 380, w: 200, h: 52 },
  { label: 'Read the docs on the Easy Labeling form', kind: 'doc', x: 35, y: 470, w: 210, h: 56 },
  { label: 'Fill out the Google Form', kind: 'action', x: 410, y: 380, w: 190, h: 52 },
  { label: 'Have a labeling policy?', kind: 'decision', x: 410, y: 462, w: 190, h: 52 },
  { label: 'File a Labeling Policy bug', kind: 'action', x: 475, y: 556, w: 150, h: 52 },
  { label: 'The form creates a new bug', kind: 'action', x: 410, y: 650, w: 190, h: 52 },
  { label: 'Share data links', kind: 'action', x: 235, y: 734, w: 190, h: 44 },
  { label: 'Monitor progress in the bug', kind: 'action', x: 225, y: 806, w: 210, h: 44 },
  { label: 'Finish!', kind: 'terminal', x: 235, y: 878, w: 190, h: 44 },
];

// arrow: false for a segment that only routes into a later one (merges, elbows).
const edges: { points: string; arrow?: boolean }[] = [
  { points: '330,52 330,92', arrow: true },
  { points: '330,136 330,162 150,162 150,190', arrow: true },
  { points: '330,162 560,162 560,268' },
  { points: '150,242 150,268' },
  { points: '150,268 560,268' },
  { points: '330,268 330,290', arrow: true },
  { points: '330,334 330,356' },
  { points: '330,356 140,356 140,380', arrow: true },
  { points: '330,356 505,356 505,380', arrow: true },
  { points: '140,432 140,470', arrow: true },
  { points: '505,432 505,462', arrow: true },
  { points: '550,514 550,556', arrow: true },
  { points: '460,514 460,650', arrow: true },
  { points: '550,608 550,650', arrow: true },
  { points: '505,702 505,716' },
  { points: '140,526 140,716' },
  { points: '140,716 505,716' },
  { points: '330,716 330,734', arrow: true },
  { points: '330,778 330,806', arrow: true },
  { points: '330,850 330,878', arrow: true },
];

const branches: { text: string; x: number; y: number }[] = [
  { text: 'Yes', x: 212, y: 146 },
  { text: 'No', x: 424, y: 146 },
  { text: 'Yes', x: 228, y: 340 },
  { text: 'No', x: 412, y: 340 },
  { text: 'No', x: 560, y: 520 },
  { text: 'Yes', x: 404, y: 580 },
];

const legend: { kind: Kind; label: string }[] = [
  { kind: 'terminal', label: 'Start / end' },
  { kind: 'decision', label: 'Decision' },
  { kind: 'action', label: 'Action' },
  { kind: 'doc', label: 'Documentation' },
];
---

<figure class="flow">
  <div class="card">
    <!-- Fixed geometry; the outline below carries the same nodes when this
         will not fit. Both are never shown at once. -->
    <div class="space" role="img" aria-label="Flow chart of the existing labeling request process, showing four entry points and two decision points">
      <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} aria-hidden="true">
        <defs>
          <marker id="flowarrow" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M0,0 L7.5,4 L0,8 z" />
          </marker>
        </defs>
        {
          edges.map((e) => (
            <polyline points={e.points} marker-end={e.arrow ? 'url(#flowarrow)' : undefined} />
          ))
        }
      </svg>
      {
        nodes.map((n) => (
          <div
            class:list={['node', n.kind]}
            style={`left:${n.x}px;top:${n.y}px;width:${n.w}px;height:${n.h}px`}
          >
            {n.label}
          </div>
        ))
      }
      {branches.map((b) => <div class="branch" style={`left:${b.x}px;top:${b.y}px`}>{b.text}</div>)}
    </div>

    <!-- Below the coordinate space's width, the same node list as an outline. -->
    <ol class="outline">
      {nodes.map((n) => <li class:list={[n.kind]}>{n.label}</li>)}
    </ol>

    <div class="aside">
      <p class="aside-label">At any point</p>
      <p class="aside-text">
        Confused? Ask someone on the Labeling team. Every box above had an unofficial fallback of finding the
        right person and having them explain it, which is how most requests actually got made.
      </p>
    </div>

    <ul class="legend">
      {
        legend.map((l) => (
          <li>
            <span class:list={['swatch', l.kind]} aria-hidden="true" />
            {l.label}
          </li>
        ))
      }
    </ul>
  </div>
  {caption && <figcaption set:html={inline(caption)} />}
</figure>

<style>
  .flow {
    display: flex;
    flex-direction: column;
    gap: var(--gap-media);
  }
  .card {
    padding: var(--pad-inset) 0 var(--s-6);
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: var(--r-media);
  }

  .space {
    position: relative;
    width: 660px;
    height: 952px;
    margin: 0 auto;
  }
  .space svg {
    position: absolute;
    inset: 0;
    display: block;
  }
  polyline {
    fill: none;
    stroke: var(--flow-line);
    stroke-width: 1;
  }
  marker path {
    fill: var(--flow-line);
  }

  .node {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: var(--s-1) var(--s-3);
    font: var(--t-small);
    text-align: center;
    text-wrap: pretty;
    border-radius: var(--r-sm);
  }
  /* Kind is carried by fill and border only. */
  .node.terminal {
    font-weight: var(--weight-medium);
    color: var(--paper);
    background: var(--accent);
    border: 1px solid var(--accent);
  }
  .node.decision {
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--accent);
  }
  .node.action {
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
  }
  .node.doc {
    color: var(--ink-body);
    background: var(--paper-sunken);
    border: 1px solid var(--rule);
  }

  /* Sits on the connector it labels, so it needs the page fill behind it. */
  .branch {
    position: absolute;
    padding: 2px var(--s-1);
    font: var(--t-mono-note);
    letter-spacing: var(--track-exchange);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--accent);
    background: var(--paper);
  }

  .outline {
    display: none;
  }

  .aside {
    display: flex;
    align-items: flex-start;
    gap: var(--s-4);
    margin: var(--s-2) var(--s-7) 0;
    padding: var(--s-5) var(--s-5);
    border: 1px dashed var(--border-dashed);
    border-radius: var(--r-sm);
  }
  .aside-label {
    flex: none;
    padding-top: 3px;
    font: var(--t-mono-note);
    letter-spacing: var(--track-exchange);
    text-transform: uppercase;
    color: var(--accent);
  }
  .aside-text {
    flex: 1;
    min-width: 0;
    font: var(--t-small);
    color: var(--ink-body);
    text-wrap: pretty;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
    margin: var(--s-6) var(--s-7) 0;
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule-soft);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font: var(--t-mono-note);
    letter-spacing: var(--track-exchange);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .swatch {
    width: 13px;
    height: 13px;
    border-radius: 3px;
  }
  .swatch.terminal {
    background: var(--accent);
    border: 1px solid var(--accent);
  }
  .swatch.decision {
    background: var(--paper);
    border: 1px solid var(--accent);
  }
  .swatch.action {
    background: var(--paper);
    border: 1px solid var(--rule);
  }
  .swatch.doc {
    background: var(--paper-sunken);
    border: 1px solid var(--rule);
  }

  figcaption {
    font: var(--t-mono-caption);
    color: var(--ink-faint);
  }

  /* The coordinate space cannot reflow, so below its width it is swapped for
     the same nodes as an ordered outline. */
  @media (max-width: 719px) {
    .space {
      display: none;
    }
    .outline {
      display: flex;
      flex-direction: column;
      gap: var(--s-2);
      margin: 0 var(--s-5);
    }
    .outline li {
      padding: var(--s-3) var(--s-4);
      font: var(--t-small);
      border-radius: var(--r-sm);
    }
    .outline li.terminal {
      font-weight: var(--weight-medium);
      color: var(--paper);
      background: var(--accent);
      border: 1px solid var(--accent);
    }
    .outline li.decision {
      color: var(--ink);
      border: 1px solid var(--accent);
    }
    .outline li.action {
      color: var(--ink);
      border: 1px solid var(--rule);
    }
    .outline li.doc {
      color: var(--ink-body);
      background: var(--paper-sunken);
      border: 1px solid var(--rule);
    }
    .aside,
    .legend {
      margin-inline: var(--s-5);
    }
  }
</style>
