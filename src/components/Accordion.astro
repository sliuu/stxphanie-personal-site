---
// One row open at a time within a group. The first row starts open on desktop
// and every row starts closed under 900px — see the inline script below.
// Drives both the case-study list and the single-row project section, so the
// two read as one pattern. Separate <Accordion> instances are separate
// groups — opening the project row does not close a case study.
import Eyebrow from './Eyebrow.astro';
import Figure from './Figure.astro';
import TextLink from './TextLink.astro';
import { resolveAsset, showPending } from '../lib/assets';

interface Item {
  index: string;
  title: string;
  emphasis?: string; // the part of the title set in --accent
  org: string;
  year: string;
  summary: string;
  href: string;
  linkLabel?: string; // defaults to the case-study wording
  external?: boolean; // ↗ instead of →
  note?: string; // small eyebrow beside the link
  thumb: string;
  thumbAlt: string;
}

interface Props {
  items: Item[];
  idPrefix: string; // panel ids; must be unique per accordion on the page
}

const { items, idPrefix } = Astro.props;
---

<div class="accordion" data-accordion>
  {
    items.map((item, i) => {
      const open = i === 0;
      const panelId = `${idPrefix}-${item.index}`;
      // The accent word is optional; without it the title is one plain run.
      const [before, after = ''] = item.emphasis ? item.title.split(item.emphasis) : [item.title];
      // A pending thumbnail is dropped from production builds; the copy then
      // takes the full width rather than sitting beside a gap.
      const hasThumb = resolveAsset(item.thumb).status !== 'pending' || showPending;
      return (
        <div class:list={['item', { 'is-open': open }]} data-item>
          <h3 class="heading">
            <button class="trigger" type="button" aria-expanded={open ? 'true' : 'false'} aria-controls={panelId}>
              <span class="index">{item.index}</span>
              <span class="title">
                {before}
                {item.emphasis && <span class="em">{item.emphasis}</span>}
                {after}
              </span>
              <span class="org">
                {item.org} · {item.year}
              </span>
              <span class="plus" aria-hidden="true">
                +
              </span>
            </button>
          </h3>
          <div class="panel" id={panelId} inert={!open}>
            <div class="clip">
              <div class:list={['body', { solo: !hasThumb }]}>
                <div class="copy">
                  <p class="summary">{item.summary}</p>
                  <div class="links">
                    <TextLink href={item.href} mono external={item.external}>
                      {item.linkLabel ?? 'read the case study'}
                    </TextLink>
                    {item.note && (
                      <Eyebrow as="span" size="label" tone="muted">
                        {item.note}
                      </Eyebrow>
                    )}
                  </div>
                </div>
                {hasThumb && (
                  <Figure
                    src={item.thumb}
                    alt={item.thumbAlt}
                    width="fill"
                    height="var(--thumb-height)"
                    position="top left"
                    radius="sm"
                    sizes="(min-width: 900px) 45vw, 100vw"
                    loading={open ? 'eager' : 'lazy'}
                  />
                )}
              </div>
            </div>
          </div>
        </div>
      );
    })
  }
</div>

<script is:inline>
  // Narrow screens start fully collapsed. An open panel is a summary plus a
  // thumbnail, which on a phone pushes the next row past the fold and makes a
  // list of studies read as a single item — the row that demonstrates the
  // interaction costs the ones below it.
  //
  // Inline and directly after the markup so it runs while parsing, before the
  // first paint: the row is never painted open, so nothing animates shut. The
  // open row is baked in at build time, which is why this can't be done in CSS.
  // Idempotent and document-wide, so the copy each <Accordion> emits is safe.
  {
    const NARROW = 899; // keep in step with the max-width query in the styles below
    if (matchMedia(`(max-width: ${NARROW}px)`).matches) {
      for (const item of document.querySelectorAll('[data-item].is-open')) {
        item.classList.remove('is-open');
        item.querySelector('button')?.setAttribute('aria-expanded', 'false');
        const panel = item.querySelector('[id]');
        if (panel) panel.inert = true;
      }
    }
  }
</script>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-accordion]')) {
    const items = [...root.querySelectorAll<HTMLElement>('[data-item]')];
    const set = (item: HTMLElement, open: boolean) => {
      item.classList.toggle('is-open', open);
      item.querySelector('button')?.setAttribute('aria-expanded', String(open));
      const panel = item.querySelector<HTMLElement>('[id]');
      if (panel) panel.inert = !open;
    };
    for (const item of items) {
      item.querySelector('button')?.addEventListener('click', () => {
        const opening = !item.classList.contains('is-open');
        for (const other of items) set(other, other === item && opening);
      });
    }
  }
</script>

<style>
  .accordion {
    /* Where the trigger's title column starts, from the item's left edge: the
       trigger's own shift (its negative margin plus its padding), then the
       index column and the gap after it. The panel hangs off the same line, so
       the summary starts under the title rather than under the number. The
       title's position is emergent from .trigger's grid with nothing to query,
       so this is kept in step with that margin, padding and column-gap by hand. */
    --title-inset: calc(var(--s-5) - var(--s-3) + var(--pad-inset) + var(--s-9));
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rule);
  }
  .item {
    border-bottom: 1px solid var(--rule);
  }
  .heading {
    font: inherit;
  }

  .trigger {
    display: grid;
    grid-template-columns: var(--pad-inset) minmax(0, 1fr) auto auto;
    column-gap: var(--s-9);
    align-items: baseline;
    width: 100%;
    margin-left: calc(-1 * var(--s-3));
    padding: var(--s-9) var(--s-5);
    border-radius: var(--r-sm);
    text-align: left;
    transition:
      transform var(--d-shift) var(--ease-shift),
      opacity var(--d-border);
  }
  .item:not(.is-open) .trigger:hover {
    opacity: 0.86;
  }
  /* Touch fires hover on tap; the nudge is for real pointers only. */
  @media (hover: hover) and (pointer: fine) {
    .item:not(.is-open) .trigger:hover {
      transform: translateX(var(--s-1));
    }
  }
  .index {
    font: var(--t-mono-small);
    color: var(--ink-decorative);
  }
  .title {
    font: var(--t-accordion);
    letter-spacing: var(--track-accordion);
    color: var(--ink);
  }
  .em {
    color: var(--accent);
  }
  .org {
    font: var(--t-mono-org);
    letter-spacing: var(--track-org);
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .plus {
    font: var(--t-plus);
    color: var(--ink);
    transition: transform var(--d-plus) var(--ease-shift);
  }
  .is-open .plus {
    transform: rotate(45deg);
  }

  /* Height animates via grid rows: 0fr → 1fr, no measured max-height. */
  .panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows var(--d-accordion) var(--ease-shift),
      opacity var(--d-fade) var(--ease-out);
  }
  .is-open .panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .clip {
    min-height: 0;
    overflow: hidden;
  }
  .body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-10);
    align-items: start;
    padding: 0 var(--s-1) var(--s-10) var(--title-inset);
  }
  /* No thumbnail: the copy runs to the reading measure instead of half-width. */
  .body.solo {
    grid-template-columns: minmax(0, var(--measure));
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--gap-head);
  }
  .summary {
    font: var(--t-lead);
    color: var(--ink-body);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3) var(--s-6);
  }

  @media (prefers-reduced-motion: reduce) {
    .trigger,
    .plus,
    .panel {
      transition: none;
    }
  }

  @media (max-width: 899px) {
    .accordion {
      /* The trigger's -s-3 margin and s-3 padding cancel at this width. */
      --title-inset: calc(var(--pad-inset) + var(--s-3));
    }
    .trigger {
      grid-template-columns: var(--pad-inset) minmax(0, 1fr) auto;
      column-gap: var(--s-3);
      row-gap: var(--s-2);
      padding: var(--s-6) var(--s-3);
    }
    .org {
      grid-column: 2;
      grid-row: 2;
    }
    .plus {
      grid-column: 3;
      grid-row: 1;
    }
    .body,
    .body.solo {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
      padding: 0 0 var(--s-9) var(--title-inset);
    }
  }
</style>
