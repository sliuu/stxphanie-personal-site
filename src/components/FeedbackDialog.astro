---
// One dialog per page; any element with [data-feedback-open] opens it.
// States: idle → sending → sent | error.
import Eyebrow from './Eyebrow.astro';
import { site } from '../data/site';

const MAX = 600;
const sourceHref = `${site.repoHref.replace(/\/$/, '')}/blob/main/src/pages/api/feedback.ts`;
// Cate Hall, "Seek real feedback" — the argument this form is built on.
const inspirationHref = 'https://usefulfictions.substack.com/i/140561314/seek-real-feedback';
---

<dialog class="dialog" data-feedback data-state="idle" aria-labelledby="feedback-title">
  <div class="card">
    <div class="head">
      <div class="titles" data-feedback-titles>
        <h2 class="title" id="feedback-title">Leave me anonymous feedback!</h2>
        <p class="sub">
          Inspired by <a href={inspirationHref} target="_blank" rel="noopener noreferrer">Cate Hall</a>. People grow
          through feedback, but knowing who sent it compromises both of us.
        </p>
      </div>
      <button type="button" class="x" data-feedback-close aria-label="Close">✕</button>
    </div>

    <!-- novalidate: an empty send gets the nudge below, not the browser's bubble. -->
    <form class="form" data-feedback-form novalidate>
      <div class="field">
        <div class="field-head">
          <label for="feedback-note"><Eyebrow as="span" size="label">Your note</Eyebrow></label>
          <span class="count" data-feedback-count>0/{MAX}</span>
          <span class="nudge" data-feedback-nudge role="status"></span>
        </div>
        <textarea id="feedback-note" name="note" maxlength={MAX} required></textarea>
      </div>

      <p class="error" data-feedback-error role="alert" hidden></p>

      <div class="actions">
        <button type="submit" class="primary" data-feedback-send>send it →</button>
      </div>

      <div class="fine">
        <p>Anonymous: only the text of your note is saved. No name, no email, no IP.</p>
        <a class="source" href={sourceHref} target="_blank" rel="noopener noreferrer"
          >api/feedback.ts — the code that receives this ↗</a
        >
      </div>
    </form>

    <div class="done" data-feedback-done hidden>
      <h2 class="done-title" tabindex="-1" data-feedback-done-title>Sent. Thank you.</h2>
      <p class="done-body">I can't reply, since I don't know who you are, but much appreciated! :)</p>
      <div class="done-actions">
        <button type="button" class="secondary" data-feedback-again>send another</button>
        <button type="button" class="primary" data-feedback-close>close</button>
      </div>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-feedback]');

  if (dialog) {
    const form = dialog.querySelector<HTMLFormElement>('[data-feedback-form]')!;
    const note = form.querySelector('textarea')!;
    const count = form.querySelector<HTMLElement>('[data-feedback-count]')!;
    const send = form.querySelector<HTMLButtonElement>('[data-feedback-send]')!;
    const error = form.querySelector<HTMLElement>('[data-feedback-error]')!;
    const done = dialog.querySelector<HTMLElement>('[data-feedback-done]')!;
    const card = dialog.querySelector<HTMLElement>('.card')!;
    const titles = dialog.querySelector<HTMLElement>('[data-feedback-titles]')!;
    const doneTitle = done.querySelector<HTMLElement>('[data-feedback-done-title]')!;
    const field = note.closest<HTMLElement>('.field')!;
    const nudge = form.querySelector<HTMLElement>('[data-feedback-nudge]')!;
    const sendLabel = send.textContent;

    // Sending an empty note: the field shakes its head and the counter's slot
    // says so. One line per try, drier each time; the last one repeats.
    const BLANK = ['that’s a blank page', 'still blank', 'even “meh” counts'];
    let blanks = 0;
    const clearNudge = () => {
      field.removeAttribute('data-nudge');
      nudge.textContent = '';
      note.removeAttribute('aria-invalid');
    };
    const showNudge = () => {
      nudge.textContent = BLANK[Math.min(blanks++, BLANK.length - 1)];
      note.setAttribute('aria-invalid', 'true');
      // Off, reflow, on: replays the shake when it's already showing.
      field.removeAttribute('data-nudge');
      void field.offsetWidth;
      field.setAttribute('data-nudge', '');
      note.focus();
    };

    type State = 'idle' | 'sending' | 'sent' | 'error';
    const setState = (state: State, message = '') => {
      dialog.dataset.state = state;
      send.disabled = state === 'sending';
      send.textContent = state === 'sending' ? 'sending…' : sendLabel;
      // Sent: hold the form's height, measured before it goes, so the card
      // doesn't collapse around the shorter confirmation.
      card.style.minHeight = state === 'sent' ? `${card.offsetHeight}px` : '';
      titles.hidden = state === 'sent';
      form.hidden = state === 'sent';
      done.hidden = state !== 'sent';
      error.hidden = state !== 'error';
      error.textContent = message;
    };

    const updateCount = () => {
      count.textContent = `${note.value.length}/${note.maxLength}`;
    };

    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('[data-feedback-open]')) return;
      if (dialog.dataset.state !== 'sending') setState('idle');
      clearNudge();
      blanks = 0;
      dialog.showModal();
      note.focus();
    });

    // Hold the dialog open with [data-closing] until its exit animation ends.
    const close = () => {
      if (!dialog.open || dialog.hasAttribute('data-closing')) return;
      dialog.setAttribute('data-closing', '');
      const exits = dialog
        .getAnimations({ subtree: true })
        .filter((a) => a instanceof CSSAnimation && a.animationName.startsWith('dialog-'))
        .map((a) => a.finished);
      Promise.allSettled(exits).then(() => dialog.close());
    };
    dialog.addEventListener('close', () => dialog.removeAttribute('data-closing'));
    // Esc: animate out instead of vanishing. (If the browser won't let this be
    // cancelled, it closes at once and the listener above tidies up.)
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });

    // The dialog has no padding, so a click that lands on it directly is on the backdrop.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as Element).closest('[data-feedback-close]')) close();
    });

    done.querySelector('[data-feedback-again]')!.addEventListener('click', () => {
      setState('idle');
      blanks = 0;
      note.focus();
    });

    note.addEventListener('input', () => {
      updateCount();
      if (field.hasAttribute('data-nudge')) clearNudge();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = note.value.trim();
      if (!text) {
        showNudge();
        return;
      }
      setState('sending');
      try {
        const res = await fetch('/api/feedback', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ note: text }),
        });
        if (res.status === 429) {
          setState('error', 'That’s a lot of notes from one place. Try again in an hour.');
          return;
        }
        if (!res.ok) throw new Error(String(res.status));
        note.value = '';
        updateCount();
        setState('sent');
        // The send button just vanished; land focus on the news instead.
        doneTitle.focus();
      } catch {
        setState('error', 'That didn’t go through. Try again in a moment.');
      }
    });
  }
</script>

<style>
  .dialog {
    width: var(--dialog-width);
    max-width: calc(100vw - 2 * var(--pad-page-x));
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: visible;
  }
  .dialog::backdrop {
    background: var(--scrim);
    backdrop-filter: blur(3px);
  }

  /* Opens from 96% about the centre; closes faster than it opens. */
  .dialog[open] {
    animation: dialog-in var(--d-modal-in) var(--ease-out);
  }
  .dialog[open]::backdrop {
    animation: dialog-fade-in var(--d-modal-in) var(--ease-out);
  }
  .dialog[data-closing] {
    animation: dialog-out var(--d-modal-out) var(--ease-out) forwards;
  }
  .dialog[data-closing]::backdrop {
    animation: dialog-fade-out var(--d-modal-out) var(--ease-out) forwards;
  }
  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
  @keyframes dialog-out {
    to {
      opacity: 0;
      transform: scale(0.96);
    }
  }
  @keyframes dialog-fade-in {
    from {
      opacity: 0;
    }
  }
  @keyframes dialog-fade-out {
    to {
      opacity: 0;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
    padding: var(--s-10) var(--s-11) var(--s-9);
    background: var(--paper-raised);
    border: 1px solid var(--border);
    border-radius: var(--r-dialog);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-6);
  }
  .titles {
    display: flex;
    flex-direction: column;
    gap: var(--gap-tight);
  }
  .titles[hidden] {
    display: none;
  }
  .title {
    font: var(--t-callout);
    letter-spacing: var(--track-callout);
  }
  .sub {
    max-width: var(--measure-note);
    font: var(--t-meta);
    color: var(--ink-muted);
  }
  /* Underlined rather than coloured: it's a citation, not a call to action. */
  .sub a {
    color: var(--ink-body);
    border-bottom: 1px solid var(--border-strong);
    transition:
      color var(--d-color),
      border-color var(--d-color);
  }
  .sub a:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }
  /* Pinned right, so it stays put when the titles hide in the sent state. */
  .x {
    margin-left: auto;
    padding: 2px var(--s-1);
    font: var(--t-close);
    color: var(--ink-faint);
    transition:
      color var(--d-color),
      transform var(--d-press) var(--ease-out);
  }
  .x:hover {
    color: var(--ink);
  }
  .x:active {
    transform: scale(0.97);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }
  .form[hidden] {
    display: none;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-tight);
  }
  .field-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .count {
    font: var(--t-mono-label);
    color: var(--ink-muted);
  }
  textarea {
    min-height: var(--field-height);
    padding: var(--s-4);
    font: var(--t-field);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    resize: vertical;
    outline: none;
    transition: border-color var(--d-color);
  }
  textarea:focus {
    border-color: var(--accent-focus);
  }

  /* Empty send. The message takes the counter's slot and rises in like the
     thank-you lines; the field shakes its head, a "no" that settles fast. */
  .nudge {
    font: var(--t-mono-label);
    color: var(--accent);
    animation: dialog-done var(--d-confirm) var(--ease-out);
  }
  .nudge:empty,
  .field[data-nudge] .count {
    display: none;
  }
  .field[data-nudge] textarea {
    border-color: var(--accent);
    animation: field-shake var(--d-shake) var(--ease-out);
  }
  @keyframes field-shake {
    20% {
      transform: translateX(calc(-1 * var(--s-1)));
    }
    45% {
      transform: translateX(var(--s-1));
    }
    70% {
      transform: translateX(calc(-0.5 * var(--s-1)));
    }
  }

  .error {
    font: var(--t-meta);
    color: var(--accent);
  }

  .actions {
    display: flex;
    justify-content: flex-end;
  }
  .primary {
    padding: var(--s-4) var(--s-6);
    font: var(--t-mono-cta);
    color: var(--paper-raised);
    background: var(--accent);
    border-radius: var(--r-md);
    transition:
      background var(--d-color),
      transform var(--d-press) var(--ease-out);
  }
  .primary:hover {
    background: var(--accent-hover);
  }
  /* Touch fires hover on tap and leaves it stuck; lift for real pointers only. */
  @media (hover: hover) and (pointer: fine) {
    .primary:hover {
      transform: translateY(-1px);
    }
  }
  .primary:active {
    transform: scale(0.97);
  }
  .primary:disabled {
    cursor: progress;
    opacity: 0.7;
    transform: none;
  }

  .fine {
    display: flex;
    flex-direction: column;
    gap: var(--gap-tight);
    padding-top: var(--gap-head);
    border-top: 1px solid var(--rule-soft);
  }
  .fine p {
    max-width: var(--measure-note);
    font: var(--t-mono-caption);
    color: var(--ink-muted);
  }
  .source {
    align-self: flex-start;
    padding-bottom: 3px;
    font: var(--t-mono-nav);
    color: var(--ink-body);
    border-bottom: 1px solid var(--border-strong);
    transition:
      color var(--d-color),
      border-color var(--d-color);
  }
  .source:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }

  /* Fills the height the form left behind, content centred in it. */
  .done {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: var(--s-4);
    padding: var(--s-1) 0 var(--s-2);
  }
  .done[hidden] {
    display: none;
  }
  .done-title {
    font: var(--t-confirm);
    letter-spacing: var(--track-confirm);
    color: var(--accent);
    /* Focused by script so it's announced; not a control, so no ring. */
    outline: none;
  }
  .done-body {
    max-width: var(--measure-note);
    font: var(--t-field);
    color: var(--ink-muted);
  }
  .done-actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .secondary {
    padding: var(--s-4) var(--s-5);
    font: var(--t-mono-cta);
    color: var(--ink-body);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    transition:
      border-color var(--d-color),
      transform var(--d-press) var(--ease-out);
  }
  .secondary:hover {
    border-color: var(--ink-decorative);
  }
  .secondary:active {
    transform: scale(0.97);
  }

  /* The thank-you lines arrive one after another. */
  .done > * {
    animation: dialog-done var(--d-confirm) var(--ease-out) backwards;
  }
  .done > :nth-child(2) {
    animation-delay: var(--stagger);
  }
  .done > :nth-child(3) {
    animation-delay: calc(2 * var(--stagger));
  }
  @keyframes dialog-done {
    from {
      opacity: 0;
      transform: translateY(var(--s-2));
    }
  }

  /* Reduced motion: keep the fades, drop the scale and rise. */
  @media (prefers-reduced-motion: reduce) {
    .dialog[open] {
      animation-name: dialog-fade-in;
    }
    .dialog[data-closing] {
      animation-name: dialog-fade-out;
    }
    .done > *,
    .nudge {
      animation-name: dialog-fade-in;
    }
    .field[data-nudge] textarea {
      animation: none;
    }
  }

  @media (max-width: 899px) {
    .card {
      padding: var(--s-9) var(--s-6) var(--s-8);
    }
  }
</style>
