---
import Eyebrow from './Eyebrow.astro';
import Figure from './Figure.astro';

interface Props {
  statements: { label: string; text: string }[];
  image: { src: string; alt: string };
}

const { statements, image } = Astro.props;
---

<div class="pair">
  <div class="statements">
    {
      statements.map((s) => (
        <div class="statement">
          <Eyebrow as="h3">{s.label}</Eyebrow>
          <p class="text">{s.text}</p>
        </div>
      ))
    }
  </div>
  <Figure {...image} width="fill" framed={false} sizes="(min-width: 900px) 45vw, 100vw" />
</div>

<style>
  .pair {
    display: grid;
    /* The portrait column is exactly an accordion thumbnail's: half of what is
       left of the row after the title inset, the panel gap and the panel's
       s-1 right padding (taken here as padding, so 100% already excludes it). */
    grid-template-columns: minmax(0, 1fr) calc((100% - var(--title-inset) - var(--s-10)) / 2);
    gap: var(--s-13);
    padding-right: var(--s-1);
    align-items: end;
    padding-top: var(--s-10);
    border-top: 1px solid var(--rule);
  }
  .statements {
    display: flex;
    flex-direction: column;
    gap: var(--s-10);
  }
  .statement {
    display: flex;
    flex-direction: column;
    gap: var(--gap-head);
  }
  .text {
    font: var(--t-large);
    letter-spacing: var(--track-large);
    color: var(--ink-soft);
  }

  @media (max-width: 899px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-10);
      padding-right: 0;
    }
  }
</style>
