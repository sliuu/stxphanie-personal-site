---
// Accent link for live projects.
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="accent-link" href={href}>{label} ↗</a>

<style>
  .accent-link {
    align-self: flex-start;
    padding-bottom: var(--s-1);
    font: var(--t-mono-cta);
    color: var(--accent);
    border-bottom: 1px solid var(--accent-line);
    transition:
      color var(--d-color),
      border-color var(--d-color);
  }
  .accent-link:hover {
    color: var(--accent-hover);
    border-color: var(--accent-hover);
  }
</style>
