---
// Headline lines rise in one after the other; the slot (the career list)
// sits bottom-aligned beside it and rises last.
interface Props {
  greeting: string;
  lead: string;
  roles: string[]; // the accent word; click to cycle
  trail?: string; // rest of the sentence, after the accent word
}

const { greeting, lead, roles, trail } = Astro.props;

// The full stop rides along, so the sentence closes with or without a trail.
const tail = trail ? ` ${trail}.` : '.';

const START = 0.35;
const STEP = 0.15;
const delay = (line: number) => `--delay: ${(START + STEP * line).toFixed(2)}s`;
---

<section class="hero">
  <h1 class="headline">
    <span class="line rise" style={delay(0)}>{greeting}</span>
    <span class="line rise" style={delay(1)}>
      {lead}{' '}
      <button class="role" type="button" data-roles={JSON.stringify(roles)} aria-live="polite">
        <span class="role-text">{roles[0]}</span>
      </button>{tail}
    </span>
  </h1>
  <!-- Waits for the headline rather than riding along with it. The last line
       starts at 0.50s and --d-enter-alt runs 1.20s; --ease-out front-loads the
       travel, so by 0.85s that line has all but landed. Earlier (0.70s) the two
       read as one movement, later (1.00s) the page sat empty long enough to
       feel slow. Change this, index.astro's --delay and BaseLayout's
       LOAD_DELAY together. -->
  <div class="aside rise" style="--delay: 0.85s">
    <slot />
  </div>
</section>

<script>
  // Fade the word out, swap it, fade it back in. Opacity only, so the swap
  // itself stays under reduced motion. The word sits mid-sentence, so the
  // button's width is animated in step with the fade — otherwise the words
  // after it snap sideways by the difference between two role names.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-roles]')) {
    const text = button.querySelector<HTMLElement>('.role-text');
    if (!text) continue;
    const roles: string[] = JSON.parse(button.dataset.roles ?? '[]');
    let i = 0;
    let timer: number | undefined;

    // Measured inside the button, so it inherits the display face at whatever
    // the fluid size currently is, and absolute so it never widens what it is
    // measuring. It's built and dropped inside this call rather than parked in
    // the DOM: anything left in there is a second copy of the word inside the
    // <h1>, which is what gets read out, crawled, and copied.
    const widthOf = (word: string) => {
      const ruler = document.createElement('span');
      ruler.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap;';
      ruler.textContent = word;
      button.append(ruler);
      const width = ruler.getBoundingClientRect().width;
      ruler.remove();
      return width;
    };

    const swap = () => {
      text.textContent = roles[i];
      button.classList.remove('is-out');
      timer = undefined;
    };

    button.addEventListener('click', () => {
      // Width animates from a number, not from auto — pin the current one
      // first, and flush it so the retarget below is a second, animated value.
      if (!button.style.width) {
        button.style.width = `${widthOf(roles[i])}px`;
        void button.offsetWidth;
      }
      i = (i + 1) % roles.length;
      button.style.width = `${widthOf(roles[i])}px`; // retargets mid-fade too
      if (timer) return; // mid-fade: the next word lands when this one does
      button.classList.add('is-out');
      const ms = parseFloat(getComputedStyle(text).transitionDuration) * 1000;
      timer = window.setTimeout(swap, ms);
    });

    // --display-size is fluid, so a pinned px width goes stale on resize.
    // Dropping it mid-fade would jump the word; the next click re-pins.
    addEventListener('resize', () => {
      if (!timer) button.style.width = '';
    });
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: var(--gap-hero);
    align-items: end;
    padding: var(--pad-hero-top) var(--pad-page-x) var(--pad-hero-bottom);
  }
  .headline {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    margin-bottom: var(--s-6);
    font: var(--t-display);
    letter-spacing: var(--track-display);
    color: var(--ink);
  }
  .role {
    display: inline-block;
    /* The width is pinned to the word's single-line width; let it wrap and
       that measurement stops matching what's drawn. */
    white-space: nowrap;
    padding-bottom: var(--s-1);
    margin-bottom: calc(-1 * var(--s-1));
    /* The headline's -0.034em tracking closes the gap after the accent word,
       so the next word sits against it. Margin rather than padding: padding
       would drag the dashed underline out past the word with it. In em so it
       holds its proportion across the fluid display size. */
    margin-right: 0.06em;
    /* Holds the word against the left edge while the width animates. */
    text-align: left;
    color: var(--accent);
    border-bottom: 1px dashed var(--accent-dash);
    transition:
      color var(--d-border),
      border-color var(--d-border),
      width var(--d-swap) var(--ease-out),
      transform var(--d-press) var(--ease-out);
  }
  .role:hover {
    color: var(--accent-hover);
    border-color: var(--accent);
  }
  .role:active {
    transform: scale(0.97);
  }
  /* Only the word fades; the dashed underline stays put. */
  .role-text {
    transition: opacity var(--d-swap) var(--ease-out);
  }
  .role.is-out .role-text {
    opacity: 0;
  }
  /* The word still swaps; only the sideways travel of the trailing text goes.
     global.css stops .rise but nothing else, so this rule is on its own. */
  @media (prefers-reduced-motion: reduce) {
    .role {
      transition:
        color var(--d-border),
        border-color var(--d-border);
    }
  }

  @media (max-width: 899px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .headline {
      margin-bottom: 0;
    }
  }
</style>
